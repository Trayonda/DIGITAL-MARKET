# DIGITAL MARKET Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Database Connection URL:
# For PostgreSQL (Production / Cloud / Local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_market_db?schema=public"
# For SQLite (Instant local testing without PostgreSQL server):
# DATABASE_URL="file:./dev.db"

# JWT Secret & Admin Cookie
JWT_SECRET="digital_market_jwt_secret_production_ready_key_998877"
JWT_EXPIRES_IN="7d"
ADMIN_COOKIE_NAME="dm_admin_session"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"

# Cloudinary Storage (Optional - falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
