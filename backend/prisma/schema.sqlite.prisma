// Prisma Schema for DIGITAL MARKET (SQLite Local Development Fallback)
// Use this for offline development when PostgreSQL is not running locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN") // SUPER_ADMIN, ADMIN
  isActive     Boolean    @default(true)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("admins")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                 String         @id @default(uuid())
  sku                String         @unique
  slug               String         @unique
  name               String
  brand              String
  model              String
  categoryId         String
  category           Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  condition          String         @default("EXCELLENT_REFURBISHED") // BRAND_NEW, OPEN_BOX, EXCELLENT_REFURBISHED, VERY_GOOD, GOOD
  description        String
  specifications     String         @default("{}") // JSON string for SQLite
  internalCostPrice  Float
  sellingPrice       Float
  originalPrice      Float?
  warranty           String?
  stockQuantity      Int            @default(1)
  availabilityStatus String         @default("AVAILABLE") // AVAILABLE, OUT_OF_STOCK, SOLD, RESERVED
  publishStatus      String         @default("PUBLISHED") // DRAFT, PUBLISHED, UNPUBLISHED
  isFeatured         Boolean        @default(false)
  viewsCount         Int            @default(0)
  images             ProductImage[]
  enquiryItems       EnquiryItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brand])
  @@index([sellingPrice])
  @@index([availabilityStatus])
  @@index([publishStatus])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Enquiry {
  id              String        @id @default(uuid())
  enquiryRef      String        @unique
  customerName    String
  customerPhone   String
  customerCity    String
  customerMessage String?
  status          String        @default("NEW") // NEW, CONTACTED, NEGOTIATION, CONVERTED, CLOSED
  internalNotes   String?
  subtotal        Float
  estimatedTotal  Float
  ipAddress       String?
  items           EnquiryItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([enquiryRef])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("enquiries")
}

model EnquiryItem {
  id           String   @id @default(uuid())
  enquiryId    String
  enquiry      Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku   String
  productName  String
  unitPrice    Float
  quantity     Int      @default(1)
  specSnapshot String   @default("{}") // JSON string for SQLite
  createdAt    DateTime @default(now())

  @@index([enquiryId])
  @@index([productId])
  @@map("enquiry_items")
}

model StoreSetting {
  id                  String   @id @default("STORE_CONFIG")
  businessName        String   @default("DIGITAL MARKET")
  businessTagline     String?  @default("Premium Refurbished Laptops, Desktop PCs & Tech Accessories")
  logoUrl             String?
  whatsappNumber      String   @default("919876543210")
  contactPhone        String?  @default("+91 98765 43210")
  contactEmail        String?  @default("contact@digitalmarket.in")
  address             String?  @default("101, Tech Plaza, Electronics Market, City Center")
  googleMapsUrl       String?
  currencySymbol      String   @default("₹")
  defaultWarrantyText String?  @default("30 Days Testing Guarantee + 6 Months Hardware Service Warranty")
  seoTitle            String?  @default("DIGITAL MARKET | Best Deals on Refurbished Laptops & Desktop PCs")
  seoDescription      String?  @default("Buy certified used and refurbished laptops, desktops, computer parts and accessories at lowest prices with testing warranty.")
  socialLinks         String   @default("{\"facebook\":\"https://facebook.com\",\"instagram\":\"https://instagram.com\",\"youtube\":\"https://youtube.com\"}")
  updatedAt           DateTime @updatedAt

  @@map("store_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      String   @default("{}")
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}
